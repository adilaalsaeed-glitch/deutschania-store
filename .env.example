# Copy this file to .env and fill in real values.
# For local dev, `npx prisma dev` prints a working DATABASE_URL you can paste in.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/deutschania?sslmode=disable"

# Generate with: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# PayTabs (https://dashboard.paytabs.com) — Profile ID and Server Key from your PayTabs dashboard.
PAYTABS_PROFILE_ID=""
PAYTABS_SERVER_KEY=""
PAYTABS_REGION="ARE"
