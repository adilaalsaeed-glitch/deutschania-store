# Copy this file to .env and fill in real values.
# For local dev, `npx prisma dev` prints a working DATABASE_URL you can paste in.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/deutschania?sslmode=disable"

# Generate with: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# PayTabs (https://dashboard.paytabs.com) — Profile ID and Server Key from your PayTabs dashboard.
PAYTABS_PROFILE_ID=""
PAYTABS_SERVER_KEY=""
PAYTABS_REGION="ARE"

# Optional pre-launch gate (see src/proxy.ts) — leave both unset to keep the site open.
# When set, every page except the PayTabs webhook requires this HTTP Basic Auth login.
SITE_USERNAME=""
SITE_PASSWORD=""

# Resend (https://resend.com) — sends the email-verification link on registration.
# Requires the sending domain (e.g. deutschania.com) to be verified in the Resend dashboard
# first (adds SPF/DKIM DNS records), or sends will fail. See src/lib/email.ts.
RESEND_API_KEY=""
