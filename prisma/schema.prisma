// Prisma schema for the deutschania store.
// Money is stored as integer cents (priceCents) to avoid floating-point rounding issues.
// Translated text (name/description/category label) is stored as JSON: {"ar": "...", "de": "...", "en": "..."}.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Origin {
  de // German products sold into the Arab world
  ar // products sourced from the Arab world, sold into Germany
}

enum LoyaltyTransactionType {
  EARN // credited when an order is confirmed PAID (1 point per 1 EUR actually paid, post-discount)
  REDEEM // debited when points are applied as a checkout discount (held at order creation)
  REFUND // reverses a REDEEM if the order that held those points later fails
}

enum ReferralStatus {
  PENDING // referred user registered via the link; reward not yet earned
  COMPLETED // referred user's first order reached PAID; both coupons issued
}

enum CouponStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

enum CouponDiscountType {
  FIXED // valueCents is a flat discount (e.g. referral's €7)
  PERCENTAGE // percentage off, e.g. content-coupon's 10%; may carry a minOrderCents floor
}

enum ContentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceSource {
  AUTO // generated the moment an order reaches PAID
  MANUAL // entered by an admin for an off-platform deal, no linked Order
}

model Category {
  key       String   @id // e.g. "cat_makeup"
  label     Json // {ar, de, en}
  icon      String // emoji, kept from the original prototype
  color     String // hex, used for card accents
  sortOrder Int      @default(0) // display order everywhere categories are listed (Postgres doesn't guarantee row order without this)
  origin    Origin
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  brand       String
  name        Json // {ar, de, en}
  description Json? // {ar, de, en}
  attributes  Json? // [{label, value}] per active language, resolved at read time
  priceCents  Int
  currency    String   @default("EUR")
  icon        String // fallback SVG key from the original prototype
  imageUrl    String?
  origin      Origin
  categoryKey String
  category    Category @relation(fields: [categoryKey], references: [key])
  featured    Boolean  @default(false)
  stockQuantity Int    @default(0) // admin-managed inventory count; 0 means out of stock
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  wishedBy   WishlistItem[]

  @@index([categoryKey])
  @@map("products")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  dateOfBirth   DateTime?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime? // null until the emailed verification link is clicked
  loyaltyPoints Int       @default(0) // cached AVAILABLE balance (points on hold for an in-flight redemption are already subtracted)
  createdAt     DateTime  @default(now())

  addresses            Address[]
  cartItems            CartItem[]
  wishlist             WishlistItem[]
  orders               Order[]
  verificationTokens   EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  loyaltyTransactions  LoyaltyTransaction[]
  coupons              Coupon[]
  referralsMade        Referral[] @relation("ReferralsMade")
  referredBy           Referral?  @relation("ReferralsReceived")
  contentSubmissions   ContentSubmission[]

  @@map("users")
}

// One row per referred user (referredId is unique — first referrer wins). Created at
// registration when a valid ?ref= link was used; flips PENDING -> COMPLETED the moment the
// referred user's first order reaches PAID (see the PayTabs webhook).
model Referral {
  id          String         @id @default(cuid())
  referrerId  String
  referrer    User           @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String         @unique
  referred    User           @relation("ReferralsReceived", fields: [referredId], references: [id], onDelete: Cascade)
  status      ReferralStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([referrerId])
  @@map("referrals")
}

// Minimal single-use, per-user discount coupon. Not the general promo-code engine (no
// admin-created public codes, no checkout redemption yet) — just enough to back referral and
// content-coupon rewards. FIXED coupons use valueCents; PERCENTAGE coupons use percentage
// (+ optional minOrderCents floor) and ignore valueCents.
model Coupon {
  id           String              @id @default(cuid())
  code         String              @unique
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountType CouponDiscountType  @default(FIXED)
  valueCents   Int                 @default(0)
  percentage   Int? // 1-100, only set when discountType is PERCENTAGE
  minOrderCents Int? // order subtotal must be at least this much to use the coupon
  source       String // "REFERRAL" | "CONTENT"
  status       CouponStatus        @default(ACTIVE)
  expiresAt    DateTime
  redeemedAt   DateTime?
  orderId      String?
  order        Order?              @relation(fields: [orderId], references: [id])
  createdAt    DateTime            @default(now())

  contentSubmission ContentSubmission?

  @@index([userId])
  @@map("coupons")
}

// A customer's request for a content/influencer coupon: they post a video about our products
// and, if approved, get a percentage coupon. Reviewed manually by an admin (follower count and
// video content aren't verified programmatically).
model ContentSubmission {
  id                String                   @id @default(cuid())
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileUrl        String
  videoUrl          String
  thumbnailUrl      String? // set at approval time: auto-fetched for TikTok (public oEmbed), manual for Instagram (no public oEmbed access)
  consentAcceptedAt DateTime
  status            ContentSubmissionStatus  @default(PENDING)
  reviewedBy        String?
  reviewedAt        DateTime?
  couponId          String?                  @unique
  coupon            Coupon?                  @relation(fields: [couponId], references: [id])
  createdAt         DateTime                 @default(now())

  @@index([userId])
  @@map("content_submissions")
}

// Generic key-value flags/config, e.g. "referrals_enabled" -> "true". Toggled from /admin so
// launch-timing decisions don't need a deploy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// Append-only ledger; User.loyaltyPoints is a cached sum kept in sync at write time.
// points is positive for EARN/REFUND, negative for REDEEM.
model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      LoyaltyTransactionType
  points    Int
  orderId   String?
  order     Order?                 @relation(fields: [orderId], references: [id])
  createdAt DateTime               @default(now())

  @@index([userId])
  @@map("loyalty_transactions")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  // Set only for an in-progress email change - the account keeps using its current,
  // already-verified email until this new one is confirmed via the link. Null for the
  // plain post-registration verification case.
  newEmail  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// Kept separate from EmailVerificationToken on purpose: that table is consumed
// immediately on GET (opening the link = done). A reset link must stay valid when
// merely opened - it's only consumed once the new password is actually submitted -
// otherwise email-security scanners that pre-fetch links would burn it before the
// real user ever clicks.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  street     String
  buildingNo String?
  city       String
  postalCode String
  country    String
  phone      String
  landline   String?
  isDefault  Boolean @default(false)

  @@map("addresses")
}

// Cart rows belong to a logged-in user (userId) or a guest (sessionId cookie) — exactly one is set.
model CartItem {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@unique([sessionId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  email           String
  shippingAddress Json // snapshot at time of order
  subtotalCents       Int
  pointsRedeemed      Int         @default(0) // points held against this order at creation time (1 point = 1 cent discount)
  pointsDiscountCents Int         @default(0) // == pointsRedeemed; kept as its own field for readability at call sites
  totalCents          Int // subtotalCents - pointsDiscountCents; what's actually charged via PayTabs
  currency            String      @default("EUR")
  status              OrderStatus @default(PENDING)
  paymentProvider     String      @default("paytabs")
  paytabsTranRef      String? // PayTabs tran_ref, set once the hosted payment page is created
  paidAt              DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  items               OrderItem[]
  loyaltyTransactions LoyaltyTransaction[]
  coupons             Coupon[]
  invoice             Invoice?

  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  nameSnapshot     Json // {ar, de, en} at time of purchase
  priceCentsAtSale Int
  quantity         Int

  @@map("order_items")
}

// One row per (year), atomically incremented to hand out the next sequence number - this is
// the single counter shared by both AUTO and MANUAL invoices, so numbering has no gaps and no
// duplicate branches. See src/lib/invoices.ts's getNextInvoiceNumber for the atomic upsert.
model InvoiceCounter {
  year       Int @id
  lastNumber Int @default(0)

  @@map("invoice_counters")
}

// A legal, immutable snapshot - once issued, nothing here changes even if the underlying
// product prices, the buyer's saved address, or seller details change later. Corrections are
// handled by issuing a separate Storno (credit note) invoice, not by editing or deleting this
// row (no delete route exists for this model on purpose).
model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // "2026-0001"
  year          Int
  sequence      Int
  source        InvoiceSource
  orderId       String?       @unique
  order         Order?        @relation(fields: [orderId], references: [id])
  createdByUserId String? // admin who entered a MANUAL invoice; null for AUTO

  issuedAt     DateTime @default(now())
  deliveryDate DateTime

  buyerName    String
  buyerAddress String
  sellerSnapshot Json // {name, address, taxId, ...} at time of issue

  lineItems     Json // [{description: {ar,de,en}, quantity, unitPriceCents, lineTotalCents}]
  subtotalCents Int
  taxRatePercent Int // 0 when the Kleinunternehmer note applies
  taxCents      Int
  totalCents    Int
  currency      String  @default("EUR")
  kleinunternehmerNote Boolean @default(false) // whether §19 UStG note was printed on this snapshot

  pdfUrlAr String? // Vercel Blob URL - null until PDF generation finishes
  pdfUrlDe String?

  createdAt DateTime @default(now())

  @@unique([year, sequence])
  @@index([orderId])
  @@map("invoices")
}
